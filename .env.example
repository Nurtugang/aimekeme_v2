# Устройство инференса (общее для всех моделей): auto | cuda | cpu | cuda:0 ...
DEVICE=auto

# fight: порог решения P(fight) >= threshold => label "fight".
FIGHT_THRESHOLD=0.5

# fire: какая модель ищет огонь/дым.
#   siglip2     — SigLIP2-классификатор кадра целиком, без боксов (не видит мелкий/ранний дым);
#   yolo_dfire  — YOLOv8n, дообучен на D-Fire: боксы вокруг очага (тянет ultralytics, AGPL-3.0);
FIRE_MODEL=siglip2

# fire: fire/smoke ниже порога уверенности => normal.
FIRE_THRESHOLD=0.5

# fire: нарезка кадра 2x2 + кадр целиком — мелкий очаг занимает бОльшую долю тайла.
USE_TILING=true

# counting: какая модель считает людей.
#   frcnn      — torchvision Faster R-CNN, класс person (BSD, ноль доп. зависимостей);
#   yolo_head  — YOLOv8-детектор голов, обучен на SCUT-HEAD (точнее в толпе; тянет ultralytics, AGPL-3.0).
COUNT_MODEL=frcnn

# counting: порог score(frcnn)/conf(yolo_head) — боксы ниже в подсчёт не идут.
COUNT_SCORE_THRESH=0.5

# counting (только yolo_head): вариант весов — medium (точнее) | nano (быстрее).
COUNT_HEAD_VARIANT=medium

# face: косинусная близость (ArcFace) >= threshold => лицо узнано (иначе "unknown").
FACE_MATCH_THRESHOLD=0.42

# face: порог уверенности детектора лиц (insightface).
FACE_DET_THRESH=0.5

KNOWN_FACES_DIR=known_faces

# auto | cuda | cpu | cuda:0 ...
DEVICE=auto

# fight

FIGHT_THRESHOLD=0.6

# fire

# siglip2 | yolo_dfire
FIRE_MODEL=yolo_dfire

FIRE_THRESHOLD=0.6

USE_TILING=true

# counting

# frcnn | yolo_head
COUNT_MODEL=yolo_head

COUNT_SCORE_THRESH=0.4

# medium | nano
COUNT_HEAD_VARIANT=medium

# face

KNOWN_FACES_DIR=known_faces

FACE_MATCH_THRESHOLD=0.42

FACE_DET_THRESH=0.5

FACE_DET_SIZE=640

FACE_MAX_UPLOAD_BYTES=5242880

FACE_MAX_IMAGE_SIDE=1600
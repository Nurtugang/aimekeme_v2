# Устройство инференса (общее для всех моделей): auto | cuda | cpu | cuda:0 ...
DEVICE=auto

# fight: порог решения P(fight) >= threshold => label "fight".
FIGHT_THRESHOLD=0.5

# fire: какая модель ищет огонь/дым.
#   siglip2     — SigLIP2-классификатор кадра целиком, без боксов (не видит мелкий/ранний дым);
#   yolo_dfire  — YOLOv8n, дообучен на D-Fire: боксы вокруг очага (тянет ultralytics, AGPL-3.0);
FIRE_MODEL=siglip2

# fire: fire/smoke ниже порога уверенности => normal.
FIRE_THRESHOLD=0.5

# fire: нарезка кадра 2x2 + кадр целиком — мелкий очаг занимает бОльшую долю тайла.
USE_TILING=true

# counting: какая модель считает людей.
#   frcnn      — torchvision Faster R-CNN, класс person (BSD, ноль доп. зависимостей);
#   yolo_head  — YOLOv8-детектор голов, обучен на SCUT-HEAD (точнее в толпе; тянет ultralytics, AGPL-3.0).
COUNT_MODEL=frcnn

# counting: порог score(frcnn)/conf(yolo_head) — боксы ниже в подсчёт не идут.
COUNT_SCORE_THRESH=0.5

# counting (только yolo_head): вариант весов — medium (точнее) | nano (быстрее).
COUNT_HEAD_VARIANT=medium

# face: косинусная близость (ArcFace) >= threshold => лицо узнано (иначе "unknown").
FACE_MATCH_THRESHOLD=0.42

# face: порог уверенности детектора лиц (insightface).
FACE_DET_THRESH=0.5

KNOWN_FACES_DIR=known_faces

# ============================ attention =============================
# Направление «на доску» в углах ВЗГЛЯДА относительно камеры. ЗАМЕРЯЕТСЯ:
#   python scripts/attention_calibrate.py   -> напечатает готовые значения.
ATTENTION_YAW_CENTER=0.0
ATTENTION_PITCH_CENTER=0.0
ATTENTION_YAW_TOLERANCE=25.0
ATTENTION_PITCH_TOLERANCE=20.0
ATTENTION_THRESHOLD=0.5
# Насколько смещение зрачка влияет на взгляд, градусов на единицу.
GAZE_EYE_GAIN=25.0

# Детектор поз (скелеты). Для 4К и мощной карты — x @ 1600.
POSE_VARIANT=x
POSE_CONF=0.35
POSE_NMS_IOU=0.6
POSE_IMGSZ=1280
POSE_KPT_CONF=0.35

# Детектор предметов: телефон в кадре надёжнее любой эвристики по позе.
# Выключение ускоряет работу, но «телефон» будет определяться только позой.
OBJECT_ENABLED=true
OBJECT_VARIANT=x
OBJECT_CONF=0.30
OBJECT_IMGSZ=1600
OBJECT_HAND_RADIUS=0.9

# Трекинг: один человек — один скелет и один стабильный id.
TRACK_IOU_THRESHOLD=0.3
TRACK_MAX_AGE_S=3.0
TRACK_MIN_HITS=3
MAX_CAMERAS=32

# Временнóе окно: вовлечённость по одному кадру не измерима.
ENGAGEMENT_WINDOW_S=30.0
ENGAGEMENT_MIN_SPAN_S=5.0
ENGAGEMENT_LOOKING_RATIO=0.5
ENGAGEMENT_HOLD_TARGET_S=5.0
ENGAGEMENT_WRITING_FLOOR=0.6
ENGAGEMENT_PHONE_FACTOR=0.2

# Сон: PERCLOS — доля времени с закрытыми глазами за окно.
SLEEP_EYE_CLOSURE=0.55
SLEEP_PERCLOS=0.7
SLEEP_MIN_CLOSED_S=3.0

# Пороги поз в ширинах плеч. ЭВРИСТИКИ — подстройте под свою аудиторию.
POSTURE_SLUMP_DROP=-0.15
POSTURE_HEAD_DOWN_DEG=18.0
POSTURE_PHONE_MIN_LIFT=-0.85
POSTURE_PHONE_TO_FACE=1.05
POSTURE_WRITE_MAX_LIFT=-0.55
POSTURE_VOTE_SHARE=0.4
